# Desactivar caché agresiva para el Service Worker (para que las actualizaciones se apliquen al instante)
/sw.js
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate

# Asegurar que el Manifest se sirva con el tipo MIME correcto
/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Access-Control-Allow-Origin: *